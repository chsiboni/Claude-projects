# ────────────────────────────────────────────────────────────────────────────
#  העתק את הקובץ הזה ל־.env ומלא את הפרטים.
#  .env נמצא ב־.gitignore ולא נשלח לשום מקום — הוא נשאר על המחשב שלך בלבד.
#  מלא רק את המקורות שיש לך; מקור שחסר בו פרט אחד פשוט לא ייאסף.
# ────────────────────────────────────────────────────────────────────────────

# בנק הפועלים — קוד משתמש וסיסמה של האתר
POALIM_USER_CODE=
POALIM_PASSWORD=

# מקס (לשעבר לאומי קארד)
MAX_USERNAME=
MAX_PASSWORD=

# כאל
CAL_USERNAME=
CAL_PASSWORD=

# ישראכרט
ISRACARD_ID=
ISRACARD_CARD6=
ISRACARD_PASSWORD=

# אמריקן אקספרס
AMEX_ID=
AMEX_CARD6=
AMEX_PASSWORD=

# ── הגדרות (אפשר להשאיר ריק לברירת מחדל) ───────────────────────────────────

# איסוף אוטומטי — ברירת מחדל: כל יום ב־06:00. ריק = כבוי.
COLLECT_CRON=0 6 * * *

# כמה חודשים אחורה למשוך באיסוף הראשון (הפועלים תומך עד 12)
INITIAL_MONTHS_BACK=12

# הפורט של הממשק המקומי
PORT=4000

# SHOW_BROWSER=1 פותח את הדפדפן כדי לראות מה קורה — שימושי כשמשהו נתקע
SHOW_BROWSER=
